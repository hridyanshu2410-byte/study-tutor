# Required: the tutor reads your handwriting and decides its moves with Claude.
ANTHROPIC_API_KEY=
# Tutor model: Claude if the key above is set, otherwise OpenAI (OPENAI_API_KEY below).
# OPENAI_TUTOR_MODEL=gpt-6-luna
# TUTOR_PROVIDER=openai

# Optional: a warmer, natural tutor voice (OpenAI text-to-speech). Without it the browser's voice is used.
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=sage

# Research mode: set all three to require sign-up, consent and cloud saving (see DEPLOY.md).
# Leave them empty to run on one device with everything saved in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that can open /admin and download the study data.
ADMIN_EMAILS=
# Optional: testers must enter this code to sign up.
STUDY_INVITE_CODE=
# Tutor turns per tester per day (default 800).
DAILY_TUTOR_LIMIT=
# Optional study arms, assigned evenly at consent: any of socratic, on_request, explain.
STUDY_CONDITIONS=
# "on" shows the quiz before first use (pre) or offers the end-of-study quiz (post).
STUDY_PRETEST=
STUDY_POSTTEST=
